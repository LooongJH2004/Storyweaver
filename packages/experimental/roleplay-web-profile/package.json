{
  "name": "@deepseek-ai/dsh-experimental-roleplay-web-profile",
  "description": "Private Web profile layer that turns the dsh shell into a roleplaying-first surface",
  "version": "0.1.2-alpha.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/roleplay-web-profile"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-api-workspace-controller": "workspace:^",
    "@deepseek-ai/dsh-atomic-write": "workspace:^",
    "@deepseek-ai/dsh-experimental-actor": "workspace:^",
    "@deepseek-ai/dsh-story-home": "workspace:^",
    "@deepseek-ai/dsh-roleplay-services": "workspace:^",
    "@deepseek-ai/dsh-api-roleplay-controller": "workspace:^",
    "@deepseek-ai/dsh-client-ui-narrative": "workspace:^",
    "@deepseek-ai/dsh-host-directory-picker-browse": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "js-yaml": "^4.2.0",
    "@deepseek-ai/dsh-roleplay-core": "workspace:^"
  }
}
